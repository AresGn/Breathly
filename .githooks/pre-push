#!/usr/bin/env bash
# Pré-push : on ne pousse (donc on n'ouvre de PR) que si tout est vert en local, et qu'aucun commit
# de la plage poussée n'a jamais contenu de secret (un secret retiré par un commit suivant reste dans l'historique).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
. ./.kit.conf

# Si GitHub ne protège pas la branche par défaut (dépôt privé, compte gratuit), le hook refuse le push direct.
# Réservé au propriétaire du dépôt (documentation, décisions) : <ALLOW_MAIN_VAR>=1 git push
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/${DEFAULT_BRANCH}" ] && [ "${!ALLOW_MAIN_VAR:-}" != "1" ]; then
    echo "pré-push : push direct sur ${DEFAULT_BRANCH} refusé (CONTRIBUTING.md §1 et §5). Ouvrir une PR." >&2
    exit 1
  fi
done

base="origin/${DEFAULT_BRANCH}"
if git rev-parse --verify -q "$base" >/dev/null; then
  bash tools/scan-secrets.sh --range "$base..HEAD"
  bash tools/run-checks.sh --since "$base"
else
  echo "pré-push : $base introuvable (git fetch origin ${DEFAULT_BRANCH}), contrôle complet"
  bash tools/scan-secrets.sh --all
  bash tools/stack.sh check
fi
echo "pré-push : OK"
