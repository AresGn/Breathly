{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breathly",
  "version": "0.0.0",
  "identifier": "io.github.aresgn.breathly",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Breathly",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Comprendre pourquoi votre PC est lent et libérer de l'espace sans risque",
    "license": "MIT"
  }
}
